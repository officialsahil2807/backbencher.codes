# ============================================================
# Backbencher.codes — Environment Variables Configuration
# ============================================================

# Site URL
NEXT_PUBLIC_SITE_URL=https://backbencher.codes

# ------------------------------------------------------------
# Supabase Authentication & Database Integration
# ------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key (Keep secret! Only used on the server)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# Google AdSense Monetization
# ------------------------------------------------------------
# Set to 'true' in production after receiving Google AdSense approval
NEXT_PUBLIC_ADS_ENABLED=false
# Your Google AdSense publisher ID (format: ca-pub-XXXXXXXXXXXXXXXX)
# This can also be set or changed at runtime via the /admin dashboard!
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX

# ------------------------------------------------------------
# Administrator Security PIN & Sessions (Fallback / Local)
# ------------------------------------------------------------
# High-security numeric/alphanumeric PIN required to sign in at /admin/login
ADMIN_SECURITY_PIN=BC-ADMIN#984201-SECURE-KEY
# Random secret string (min 32 characters) for signing admin session tokens
ADMIN_SESSION_SECRET=backbencher-super-secret-admin-session-key-32chars
